# ===========================================================================
# PROJECT-SPECIFIC: RESTRICTED DATA -- never commit.
#
# The DementiaBank Pitt corpus is distributed under a TalkBank membership
# agreement that forbids redistribution. Anything containing transcript text,
# audio, or vectors derived from them stays local. Researchers reproduce this
# work by obtaining their own DementiaBank access and re-running the pipeline.
# ===========================================================================
Pitt.cha/
Pitt.wav/
Pitt_Processed_PAR_Only/
*.cha
*.wav

# Derived from the protected transcripts (hidden states, per-visit records)
artifacts/

# ---------------------------------------------------------------------------
# Paper, figures and result tables are kept local, not published here.
# ---------------------------------------------------------------------------
paper/
figures/
results/

# Model weight caches, if pointed at the repo
.cache/
huggingface/
*.safetensors

# ===========================================================================
# Python  (github/gitignore Python.gitignore, trimmed to what applies here)
# ===========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

